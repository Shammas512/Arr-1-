class Solution {
  public:
    int longestSubarray(vector<int>& arr, int k) {
      int n = arr.size();
      int j = 0;
      int i = 0;
      int count = 0;
      long long sum = arr[0];
      while(j<n){
          while(sum>k){
              sum-=arr[i];
              i++;
          }
          if(sum==k) count = max(count,(j-i)+1);
          
          j++;
          if(j<n){
              sum+=arr[j];
          }
          
      }
        return count;
    }
};
