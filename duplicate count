#include <iostream>
using namespace std;
#include <vector>
int main(){
    int n;
    cin >> n;
    vector <int> arr(n);
    for (int i = 0 ; i < n ; i++){
        cin >> arr[i];   // array must be sorted 
    }


     int i = 0;
     for(int j =1 ;j<n ; j++){
        if(arr[j] != arr[i]){
            arr[i+1] =  arr[j];
            i++;
        }
     }

     for (int k = 0 ;k < n ; k++){
        cout << arr[k] << endl ;
     }

     cout << i+1 << "Unique numbers";
}
