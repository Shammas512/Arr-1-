int majorityElement(int* nums, int numsSize) {
    	int el;
	int count = 0;
	int i;
	for(i=0;i<numsSize;i++){
		if(count==0){
			el=nums[i];
			count =1;
		}
		else if(nums[i]==el){
			count++;
		}
		else{
			count--;
		}
	}
	int cnt1=0;
	for(i=0;i<numsSize;i++){
		if(nums[i]==el){
			cnt1++;
		}
	}
	if(cnt1>numsSize/2) return el;
    return 0;
}
