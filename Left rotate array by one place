#include <iostream>
using namespace std;
#include <vector>

int myapproach(vector <int> &arr , int n){
   int fe = arr[0];
   for(int i =1 ; i < n ; i ++ ){
    arr[i-1] = arr[i];
   }
   arr[n-1] = fe;


   for (int i : arr) {
    cout << i << " ";
   }
   return 0 ;
}
int main(){
    int n;
    cin >> n;
    vector <int> arr(n);
    for (int i = 0 ; i < n ; i++){
        cin >> arr[i];  
    }
    myapproach(arr,n);

    return 0 ;
}
