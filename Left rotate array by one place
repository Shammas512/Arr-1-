#include <iostream>
using namespace std;
#include <vector>

int myapproach(vector <int> &arr , int n){
   int fe = arr[0];
   for(int i =1 ; i < n ; i ++ ){
    arr[i-1] = arr[i];
   }
   arr[n-1] = fe;


   for (int i : arr) {
    cout << i << " ";
   }
   return 0 ;
}


int leftrotate (vector <int> & arr , int n , int k){
    vector <int> temp (n);
    k = k%n;
    for(int i= 0 ; i < k ; i++){
        temp[i] = arr[i];
    }
    for(int j = k ; j<n ; j++){
        arr[j-k] = arr[j];
    }

    for(int l = n-k ; l<n; l++){
        arr[l] =  temp[l-(n-k)];
    }
   
    for (int i : arr) {
    cout << i << " ";
   }
  return 0 ;
}
int main(){
    int n;
    cin >> n;
    vector <int> arr(n);
    for (int i = 0 ; i < n ; i++){
        cin >> arr[i];  
    }
   leftrotate(arr,n ,3);

    return 0 ;
}
