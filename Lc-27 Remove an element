class Solution {
public:
    int removeElement(vector<int>& nums, int val) {
        int n =  nums.size();
        int k =0;
        int index = -1;
        for(int i = 0 ;i<n;i++){
            if(nums[i]==val){
                index = i;
                break;
            }
            else{
                k++;
            }
        }

        if(index==-1) return k;
        else{
            for(int j = index+1; j<n;j++){
                if(nums[j]!=val){
                    swap(nums[index],nums[j]);
                    index++;
                    k++;
                }
            }
            return k;
        }
    }
};
